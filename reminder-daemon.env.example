# reminder-daemon secrets — TEMPLATE.
#
# Copy this to the host (NOT into the repo) and fill in the real values:
#
#   sudo install -d -m 700 /etc/sando-scheduler
#   sudo install -m 600 reminder-daemon.env.example /etc/sando-scheduler/reminder-daemon.env
#   sudo "$EDITOR" /etc/sando-scheduler/reminder-daemon.env
#
# reminder-daemon.service loads it via EnvironmentFile=. deploy.sh will
# create it from this template on first run if it is missing.
#
# Never commit the filled-in file. `*.env` is gitignored as a safety net.

# From @BotFather. Rotate immediately if it is ever exposed.
TELEGRAM_BOT_TOKEN=replace-with-bot-token-from-botfather

# Target "Scheduling" chat ID (often negative for group chats).
TELEGRAM_CHAT_ID=replace-with-target-chat-id
